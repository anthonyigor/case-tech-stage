// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client"
  output        = "../generated/prisma"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProcessType {
  MANUAL
  SYSTEM
}

enum ProcessStatus {
  DRAFT
  ACTIVE
  DEPRECATED
}

enum ToolType {
  SYSTEM
  TOOL
}

model User {
  id       String @id @default(uuid())
  username String @unique
  email    String @unique
  password String

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("users")
}

model Area {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  processes Process[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("areas")
}

model Process {
  id      String @id @default(uuid())
  area_id String
  area    Area   @relation(fields: [area_id], references: [id], onDelete: Cascade)

  parent_id String?
  parent    Process?  @relation("ProcessTree", fields: [parent_id], references: [id], onDelete: Restrict)
  children  Process[] @relation("ProcessTree")

  title       String
  description String?
  type        ProcessType   @default(MANUAL)
  status      ProcessStatus @default(DRAFT)
  position    Int           @default(0) // posição na árvore de processos

  tools  ProcessTool[]
  owners ProcessOwner[]
  docs   ProcessDoc[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([area_id])
  @@index([parent_id])
  @@index([area_id, parent_id, position])
  @@map("processes")
}

model ProcessTool {
  id         String  @id @default(uuid())
  process_id String
  process    Process @relation(fields: [process_id], references: [id], onDelete: Cascade)

  name String
  type ToolType @default(TOOL)
  url  String?

  created_at DateTime @default(now())

  @@index([process_id])
  @@map("process_tools")
}

model ProcessDoc {
  id         String  @id @default(uuid())
  process_id String
  process    Process @relation(fields: [process_id], references: [id], onDelete: Cascade)

  title String
  url   String

  created_at DateTime @default(now())

  @@index([process_id])
  @@map("process_docs")
}

model ProcessOwner {
  id         String  @id @default(uuid())
  process_id String
  process    Process @relation(fields: [process_id], references: [id], onDelete: Cascade)
  people_id  String
  people     People  @relation(fields: [people_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())

  @@unique([process_id, people_id])
  @@index([process_id])
  @@index([people_id])
  @@map("process_owners")
}

model People {
  id String @id @default(uuid())

  name    String
  email   String  @unique
  role    String?
  team_id String?
  team    Team?   @relation(fields: [team_id], references: [id], onDelete: Restrict)

  processOwners ProcessOwner[]

  created_at DateTime @default(now())

  @@map("people")
}

model Team {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  people      People[]

  created_at DateTime @default(now())

  @@map("teams")
}
